# ── Compiled example / smoke / tinynn binaries (Spinel builds; the .rb (and
# .c/.cu/.m/.py) sources alongside them stay tracked). Glob-based so a newly
# built binary is ignored AUTOMATICALLY — this replaces the fragile per-name
# blocklist above and prevents `git add -A` from ever sweeping a build output
# (incl. the ~680 MB CUDA binaries) into a commit.
examples/example_*
examples/gpt2_train
# Stray smoke builds: the gate smokes live in (and build into) prep/smokes/,
# but older builds dropped binaries here too. Guard so a 680 MB CUDA smoke can
# never be swept in from examples/ (the .rb sources, if any, stay via the rule below).
examples/smoke_*
!examples/*.rb
# Gate-smoke binaries (prep/smokes/): .rb sources tracked, Spinel builds ignored.
prep/smokes/smoke_*
!prep/smokes/*.rb
tinynn/ab_smoke_*
tinynn/probe_*
!tinynn/*.rb
!tinynn/*.c
!tinynn/*.h
!tinynn/*.cu
!tinynn/*.m
!tinynn/*.py
!tinynn/*.md
# Regenerable smoke datasets (created by prep/ scripts).
# NOTE: data/vit_smoke/ is the PINNED vit-tiny gate corpus — it is COMMITTED
# (a gate fixture, like prep/fixtures/ts_seqs_gate.bin), NOT scratch, so it is
# deliberately NOT ignored here (the train_gate vit-tiny case must reproduce
# cross-machine). Only top-level scratch .bin stay ignored.
data/*.bin

