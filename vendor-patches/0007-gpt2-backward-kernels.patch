+// ggml_compute_forward_norm_back
+// toy: backward of the pure normalize ggml_norm (no affine), GPT-2 training.
+//   y    = (x - mean)/sqrt(var + eps),  xhat = (x - mean)*rstd
+//   dx_i = rstd * ( dy_i - mean(dy) - xhat_i * mean(dy .* xhat) )
+// mean/var convention matches ggml_compute_forward_norm_f32 (mean over ne0,
+// population variance). src[0] = x, src[1] = dy.
+
+static void ggml_compute_forward_norm_back_f32(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    const ggml_tensor * src0 = dst->src[0]; // x  from the forward pass
+    const ggml_tensor * src1 = dst->src[1]; // dy (gradient of the normalize output)
+
+    GGML_ASSERT(ggml_are_same_shape(src0, dst) && ggml_are_same_shape(src0, src1));
+
+    GGML_ASSERT(src0->nb[0] == sizeof(float));
+    GGML_ASSERT(src1->nb[0] == sizeof(float));
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    GGML_TENSOR_BINARY_OP_LOCALS
+
+    float eps;
+    memcpy(&eps, dst->op_params, sizeof(float));
+    GGML_ASSERT(eps >= 0.0f);
+
+    for (int64_t i03 = 0; i03 < ne03; i03++) {
+        for (int64_t i02 = 0; i02 < ne02; i02++) {
+            for (int64_t i01 = ith; i01 < ne01; i01 += nth) {
+                // src1 (dy) is same shape as src0 (x) => same indices
+                const int64_t i11 = i01;
+                const int64_t i12 = i02;
+                const int64_t i13 = i03;
+
+                const float * x  = (float *) ((char *) src0->data + i01*nb01 + i02*nb02 + i03*nb03);
+                const float * dy = (float *) ((char *) src1->data + i11*nb11 + i12*nb12 + i13*nb13);
+                float       * dx = (float *) ((char *) dst->data  + i01*nb1  + i02*nb2  + i03*nb3);
+
+                // mean(x)
+                ggml_float sum_x = 0.0;
+                for (int64_t i00 = 0; i00 < ne00; i00++) {
+                    sum_x += (ggml_float)x[i00];
+                }
+                const float mean = (float)(sum_x/ne00);
+
+                // var(x) (population), then rstd
+                ggml_float sum_v = 0.0;
+                for (int64_t i00 = 0; i00 < ne00; i00++) {
+                    const float xc = x[i00] - mean;
+                    sum_v += (ggml_float)(xc*xc);
+                }
+                const float var  = (float)(sum_v/ne00);
+                const float rstd = 1.0f/sqrtf(var + eps);
+
+                // mean(dy) and mean(dy .* xhat)
+                ggml_float sum_dy   = 0.0;
+                ggml_float sum_dyxh = 0.0;
+                for (int64_t i00 = 0; i00 < ne00; i00++) {
+                    const float xhat = (x[i00] - mean)*rstd;
+                    sum_dy   += (ggml_float)dy[i00];
+                    sum_dyxh += (ggml_float)(dy[i00]*xhat);
+                }
+                const float mean_dy   = (float)(sum_dy/ne00);
+                const float mean_dyxh = (float)(sum_dyxh/ne00);
+
+                for (int64_t i00 = 0; i00 < ne00; i00++) {
+                    const float xhat = (x[i00] - mean)*rstd;
+                    dx[i00] = rstd*(dy[i00] - mean_dy - xhat*mean_dyxh);
+                }
+            }
+        }
+    }
+}
+
+void ggml_compute_forward_norm_back(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    const ggml_tensor * src0 = dst->src[0];
+
+    switch (src0->type) {
+        case GGML_TYPE_F32:
+            {
+                ggml_compute_forward_norm_back_f32(params, dst);
+            } break;
+        default:
+            {
+                GGML_ABORT("fatal error");
+            }
+    }
+}
